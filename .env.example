# Copy to .env.local and fill in your Supabase project's values.
# EXPO_PUBLIC_ prefix is required for Expo to inline these into the client bundle.
# The publishable key is safe to expose client-side (that's its purpose,
# backed by RLS) — never put the secret/service_role key in an
# EXPO_PUBLIC_ variable, it must only ever be used server-side (Edge Functions).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. "true" shows plans/upgrade UI on the web build only (never in
# the iOS/Android apps - see docs/MONETIZATION.md). Leave unset until the
# billing Edge Function has its Stripe secrets.
EXPO_PUBLIC_BILLING_ENABLED=
