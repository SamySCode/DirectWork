# Copy to .env.local and fill in once a Supabase project exists.
# EXPO_PUBLIC_ prefix is required for Expo to inline these into the client bundle.
# Never put the service_role key in an EXPO_PUBLIC_ variable — it must only
# ever be used server-side (Edge Functions), never shipped to a client.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
