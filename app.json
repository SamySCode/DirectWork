{
  "expo": {
    "name": "DirectWork",
    "slug": "directwork",
    "scheme": "directwork",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.directwork.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16133D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.directwork.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "DirectWork",
      "shortName": "DirectWork",
      "description": "A curated place for professionals to take on paid projects or join early ventures as partners.",
      "themeColor": "#16133D",
      "backgroundColor": "#F5F4FC"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#16133D"
        }
      ],
      "expo-web-browser",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "DirectWork uses your photo library so you can add a profile photo, listing images and work samples.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
