{
  "name": "directwork",
  "version": "0.1.0",
  "private": true,
  "description": "DirectWork - a direct professional project and job marketplace.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/generate-route-types.js && tsc --noEmit",
    "test:db": "node --test supabase/tests/db/db.test.mjs",
    "test:rls:live": "node supabase/tests/rls-profiles.mjs",
    "test": "npm run test:unit && npm run test:db",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "test:unit": "jest",
    "test:functions": "npx --yes deno@2.5.6 test --allow-env=ALLOWED_ORIGINS supabase/functions",
    "check:functions": "npx --yes deno@2.5.6 check supabase/functions/*/index.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.15",
    "@types/react": "~19.2.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-expo": "57.0.4",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.105.3",
    "aes-js": "^3.1.2",
    "expo": "^57.0.11",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.4.3"
  }
}
