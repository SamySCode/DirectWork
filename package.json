{
  "name": "directwork",
  "version": "0.1.0",
  "private": true,
  "description": "DirectWork - a direct professional project and job marketplace.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/generate-route-types.js && tsc --noEmit",
    "test:db": "node --test supabase/tests/db/db.test.mjs",
    "test:rls:live": "node supabase/tests/rls-profiles.mjs",
    "test": "npm run test:unit && npm run test:db",
    "check:launch": "node scripts/check-launch.js",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "test:unit": "jest",
    "test:functions": "npx --yes deno@2.5.6 test --allow-env=ALLOWED_ORIGINS supabase/functions",
    "check:functions": "npx --yes deno@2.5.6 check supabase/functions/*/index.ts",
    "audit:prod": "node scripts/audit-prod.js",
    "scan:secrets": "node scripts/secret-scan.js --all",
    "hooks:install": "git config core.hooksPath scripts/git-hooks",
    "build:web": "expo export --platform web && node scripts/apply-web-headers.js dist"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "30.0.0",
    "@types/node": "^20.14.15",
    "@types/react": "~19.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.3.3",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.105.3",
    "aes-js": "^3.1.2",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  }
}
